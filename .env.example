python -c "from app.config import get_settings; s=get_settings(); print('Forager key loaded:', bool(s.forager_api_key)); print('Account ID:', s.forager_account_id); print('HubSpot token loaded:', bool(s.hubspot_token))"FORAGER_API_KEY=your_forager_api_key
FORAGER_ACCOUNT_ID=your_account_id
HUBSPOT_TOKEN=your_hubspot_token
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
PUBLIC_BASE_URL=
API_SECRET=your_api_secret
DEFAULT_INCLUDE_TITLES=CEO,Chief,CTO,CFO,COO,VP,Head of,Director
DEFAULT_EXCLUDE_TITLES=Intern,Assistant
MAX_CONTACTS=5
ENABLE_EXTRAS=true